{{ 'customer.css' | asset_url | stylesheet_tag }}

<div class="customer-auth-page container">
  <div class="auth-card">
    <div class="auth-header text-center">
      <img src="{{ 'vimi-logo.png' | asset_url }}" alt="ViMi" class="auth-logo" onerror="this.src='./assets/vimi-logo.png';">
      <h1 class="auth-title">ACTIVATE ACCOUNT</h1>
      <p class="auth-subtitle">Create a password to activate your ViMi Syndicate membership.</p>
    </div>

    <div class="auth-form-wrapper">
      {% form 'activate_customer_password', class: 'auth-form' %}
        {%- if form.errors -%}
          <div class="login-form-errors" tabindex="-1" autofocus>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="form-group">
          <label for="password">Password</label>
          <input
            type="password"
            name="customer[password]"
            id="password"
            autocomplete="new-password"
            required
            class="form-input"
            placeholder="Minimum 6 characters"
          >
        </div>

        <div class="form-group">
          <label for="password_confirmation">Confirm Password</label>
          <input
            type="password"
            name="customer[password_confirmation]"
            id="password_confirmation"
            autocomplete="new-password"
            required
            class="form-input"
            placeholder="Confirm password"
          >
        </div>

        <button type="submit" class="btn btn--primary btn--full auth-submit-btn">
          <span>ACTIVATE ACCOUNT</span>
        </button>

        <button type="submit" name="decline" class="btn btn--outline btn--full btn-decline-invitation" style="margin-top: 10px;">
          <span>DECLINE INVITATION</span>
        </button>
      {% endform %}
    </div>
  </div>
</div>
