{{ 'customer.css' | asset_url | stylesheet_tag }}

<div class="customer-account-page container">
  <div class="account-header">
    <div class="account-header__info">
      <a href="{{ routes.account_url }}" class="back-link">← Back to Account Dashboard</a>
      <h1 class="account-title">ADDRESS DIRECTORY</h1>
      <p class="account-meta">Manage your delivery destinations for rapid 1-click checkout.</p>
    </div>
    <div class="account-header__actions">
      <button type="button" class="btn btn--primary btn--sm" id="BtnOpenNewAddress">
        + ADD NEW ADDRESS
      </button>
    </div>
  </div>

  <!-- Add New Address Modal / Form -->
  <div id="AddAddressModal" class="address-modal" style="display: none;">
    <div class="address-modal-content">
      <div class="address-modal-header">
        <h3 class="card-title">ADD NEW SHIPPING DESTINATION</h3>
        <button type="button" class="btn-close-modal" id="BtnCloseNewAddress">✕</button>
      </div>

      {% form 'customer_address', customer.new_address, class: 'address-form' %}
        <div class="form-row-2col">
          <div class="form-group">
            <label for="AddressFirstNameNew">First Name</label>
            <input type="text" id="AddressFirstNameNew" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name" required class="form-input">
          </div>
          <div class="form-group">
            <label for="AddressLastNameNew">Last Name</label>
            <input type="text" id="AddressLastNameNew" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name" required class="form-input">
          </div>
        </div>

        <div class="form-group">
          <label for="AddressCompanyNew">Company / Apt / Landmark (Optional)</label>
          <input type="text" id="AddressCompanyNew" name="address[company]" value="{{ form.company }}" autocomplete="organization" class="form-input">
        </div>

        <div class="form-group">
          <label for="AddressAddress1New">Street Address</label>
          <input type="text" id="AddressAddress1New" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" required class="form-input" placeholder="House / Flat No., Street, Area">
        </div>

        <div class="form-group">
          <label for="AddressAddress2New">Apartment, Suite, Unit (Optional)</label>
          <input type="text" id="AddressAddress2New" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2" class="form-input">
        </div>

        <div class="form-row-2col">
          <div class="form-group">
            <label for="AddressCityNew">City</label>
            <input type="text" id="AddressCityNew" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" required class="form-input">
          </div>
          <div class="form-group">
            <label for="AddressCountryNew">Country</label>
            <select id="AddressCountryNew" name="address[country]" data-default="{{ form.country }}" autocomplete="country" class="form-select">
              {{ all_country_option_tags }}
            </select>
          </div>
        </div>

        <div class="form-row-2col">
          <div class="form-group">
            <label for="AddressProvinceNew">State / Province</label>
            <input type="text" id="AddressProvinceNew" name="address[province]" value="{{ form.province }}" class="form-input">
          </div>
          <div class="form-group">
            <label for="AddressZipNew">PIN Code / Postal Code</label>
            <input type="text" id="AddressZipNew" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code" required class="form-input">
          </div>
        </div>

        <div class="form-group">
          <label for="AddressPhoneNew">Phone Number (Required for Indian Courier Tracking)</label>
          <input type="tel" id="AddressPhoneNew" name="address[phone]" value="{{ form.phone }}" autocomplete="tel" required class="form-input" placeholder="+91 98765 43210">
        </div>

        <div class="form-checkbox-group">
          {{ form.set_as_default_checkbox }}
          <label for="address_default_address_new">Set as default shipping address</label>
        </div>

        <div class="modal-actions">
          <button type="submit" class="btn btn--primary">SAVE ADDRESS</button>
          <button type="button" class="btn btn--outline" id="BtnCancelNewAddress">CANCEL</button>
        </div>
      {% endform %}
    </div>
  </div>

  <!-- Saved Addresses List -->
  {%- paginate customer.addresses by 10 -%}
    {%- if customer.addresses.size > 0 -%}
      <div class="addresses-grid">
        {%- for address in customer.addresses -%}
          <div class="address-item-card {% if address == customer.default_address %}is-default{% endif %}" id="AddressCard_{{ address.id }}">
            <div class="address-card-header">
              {%- if address == customer.default_address -%}
                <span class="default-badge">★ DEFAULT ADDRESS</span>
              {%- else -%}
                <span class="secondary-badge">SAVED ADDRESS</span>
              {%- endif -%}
            </div>

            <div class="address-card-body">
              <p class="address-name font-bold">{{ address.name }}</p>
              {%- if address.company != blank -%}
                <p>{{ address.company }}</p>
              {%- endif -%}
              <p>{{ address.street }}</p>
              <p>{{ address.city }}{% if address.province_code %}, {{ address.province_code }}{% endif %} {{ address.zip }}</p>
              <p>{{ address.country }}</p>
              {%- if address.phone != blank -%}
                <p class="address-phone font-mono">{{ address.phone }}</p>
              {%- endif -%}
            </div>

            <div class="address-card-actions">
              <button type="button" class="btn btn--outline btn--sm btn-edit-address" data-target="EditAddress_{{ address.id }}">
                EDIT
              </button>
              <form method="post" action="/account/addresses/{{ address.id }}" onsubmit="return confirm('Are you sure you want to delete this address?');">
                <input type="hidden" name="_method" value="delete">
                <button type="submit" class="btn btn--text-danger btn--sm">DELETE</button>
              </form>
            </div>

            <!-- Edit Form for this Address -->
            <div id="EditAddress_{{ address.id }}" class="edit-address-modal" style="display: none;">
              <div class="address-modal-content">
                <div class="address-modal-header">
                  <h3 class="card-title">EDIT SHIPPING DESTINATION</h3>
                  <button type="button" class="btn-close-modal" data-close="EditAddress_{{ address.id }}">✕</button>
                </div>

                {% form 'customer_address', address, class: 'address-form' %}
                  <div class="form-row-2col">
                    <div class="form-group">
                      <label for="AddressFirstName_{{ form.id }}">First Name</label>
                      <input type="text" id="AddressFirstName_{{ form.id }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name" required class="form-input">
                    </div>
                    <div class="form-group">
                      <label for="AddressLastName_{{ form.id }}">Last Name</label>
                      <input type="text" id="AddressLastName_{{ form.id }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name" required class="form-input">
                    </div>
                  </div>

                  <div class="form-group">
                    <label for="AddressCompany_{{ form.id }}">Company (Optional)</label>
                    <input type="text" id="AddressCompany_{{ form.id }}" name="address[company]" value="{{ form.company }}" autocomplete="organization" class="form-input">
                  </div>

                  <div class="form-group">
                    <label for="AddressAddress1_{{ form.id }}">Street Address</label>
                    <input type="text" id="AddressAddress1_{{ form.id }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" required class="form-input">
                  </div>

                  <div class="form-group">
                    <label for="AddressAddress2_{{ form.id }}">Apartment, Suite (Optional)</label>
                    <input type="text" id="AddressAddress2_{{ form.id }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2" class="form-input">
                  </div>

                  <div class="form-row-2col">
                    <div class="form-group">
                      <label for="AddressCity_{{ form.id }}">City</label>
                      <input type="text" id="AddressCity_{{ form.id }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" required class="form-input">
                    </div>
                    <div class="form-group">
                      <label for="AddressCountry_{{ form.id }}">Country</label>
                      <select id="AddressCountry_{{ form.id }}" name="address[country]" data-default="{{ form.country }}" autocomplete="country" class="form-select">
                        {{ all_country_option_tags }}
                      </select>
                    </div>
                  </div>

                  <div class="form-row-2col">
                    <div class="form-group">
                      <label for="AddressProvince_{{ form.id }}">State / Province</label>
                      <input type="text" id="AddressProvince_{{ form.id }}" name="address[province]" value="{{ form.province }}" class="form-input">
                    </div>
                    <div class="form-group">
                      <label for="AddressZip_{{ form.id }}">PIN Code</label>
                      <input type="text" id="AddressZip_{{ form.id }}" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code" required class="form-input">
                    </div>
                  </div>

                  <div class="form-group">
                    <label for="AddressPhone_{{ form.id }}">Phone Number</label>
                    <input type="tel" id="AddressPhone_{{ form.id }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel" required class="form-input">
                  </div>

                  <div class="form-checkbox-group">
                    {{ form.set_as_default_checkbox }}
                    <label for="address_default_address_{{ form.id }}">Set as default shipping address</label>
                  </div>

                  <div class="modal-actions">
                    <button type="submit" class="btn btn--primary">UPDATE ADDRESS</button>
                    <button type="button" class="btn btn--outline" data-close="EditAddress_{{ address.id }}">CANCEL</button>
                  </div>
                {% endform %}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="account-empty-state">
        <div class="empty-icon">📍</div>
        <h3>NO SAVED DESTINATIONS</h3>
        <p>You haven't saved any delivery addresses yet.</p>
        <button type="button" class="btn btn--primary" id="BtnOpenNewAddressEmpty">
          <span>ADD FIRST ADDRESS</span>
        </button>
      </div>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <div class="pagination">
        {{ paginate | default_pagination }}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

<script>
  (function() {
    var btnOpen = document.getElementById('BtnOpenNewAddress');
    var btnOpenEmpty = document.getElementById('BtnOpenNewAddressEmpty');
    var modal = document.getElementById('AddAddressModal');
    var btnClose = document.getElementById('BtnCloseNewAddress');
    var btnCancel = document.getElementById('BtnCancelNewAddress');

    function openAddModal() {
      if (modal) modal.style.display = 'flex';
    }
    function closeAddModal() {
      if (modal) modal.style.display = 'none';
    }

    if (btnOpen) btnOpen.addEventListener('click', openAddModal);
    if (btnOpenEmpty) btnOpenEmpty.addEventListener('click', openAddModal);
    if (btnClose) btnClose.addEventListener('click', closeAddModal);
    if (btnCancel) btnCancel.addEventListener('click', closeAddModal);

    // Edit toggles
    document.querySelectorAll('.btn-edit-address').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var targetId = btn.getAttribute('data-target');
        var targetEl = document.getElementById(targetId);
        if (targetEl) targetEl.style.display = 'flex';
      });
    });

    document.querySelectorAll('[data-close]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var targetId = btn.getAttribute('data-close');
        var targetEl = document.getElementById(targetId);
        if (targetEl) targetEl.style.display = 'none';
      });
    });
  })();
</script>
