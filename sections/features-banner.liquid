<section class="section-features">
  <div class="container">
    <div class="features-grid">
      
      <div class="feature-item">
        <div class="feature-icon-box">
          {% render 'icon-truck' %}
        </div>
        <div class="feature-text">
          <h4 class="feature-title">Pan-India Express Shipping</h4>
          <p class="feature-desc">Free delivery on orders above ₹999. Dispatched in 24 hours.</p>
        </div>
      </div>

      <div class="feature-item">
        <div class="feature-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <line x1="2" y1="10" x2="22" y2="10"/>
            <path d="M6 15h2"/>
          </svg>
        </div>
        <div class="feature-text">
          <h4 class="feature-title">Cash on Delivery (COD)</h4>
          <p class="feature-desc">Pay at your doorstep with Cash or UPI scanner on delivery.</p>
        </div>
      </div>

      <div class="feature-item">
        <div class="feature-icon-box">
          {% render 'icon-shield' %}
        </div>
        <div class="feature-text">
          <h4 class="feature-title">450 GSM Heavy French Terry</h4>
          <p class="feature-desc">100% combed cotton, bio-washed and pre-shrunk for maximum longevity.</p>
        </div>
      </div>

      <div class="feature-item">
        <div class="feature-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="23 4 23 10 17 10"/>
            <polyline points="1 20 1 14 7 14"/>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
          </svg>
        </div>
        <div class="feature-text">
          <h4 class="feature-title">7-Day Easy Exchange</h4>
          <p class="feature-desc">Got the wrong size? Hassle-free doorstep pickup & size swap.</p>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Features Banner",
  "settings": [],
  "presets": [
    {
      "name": "Features Banner"
    }
  ]
}
{% endschema %}
