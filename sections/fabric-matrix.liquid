<section class="section-comparison" id="fabric-matrix">
  <div class="container text-center">
    
    <div style="max-width: 680px; margin: 0 auto;">
      <span style="font-size: 0.74rem; font-weight: 800; letter-spacing: 2px; color: #71717a; text-transform: uppercase;">WHY WEIGHT MATTERS</span>
      <h2 style="font-family: 'Syne', sans-serif; font-size: 2.3rem; font-weight: 800; margin-top: 8px; margin-bottom: 12px;">FABRIC & GSM SPECIFICATION MATRIX</h2>
      <p style="color: #a1a1aa; font-size: 0.95rem;">Why most market hoodies lose shape, while ViMi wears like armor.</p>
    </div>

    <div class="comparison-table-wrap">
      <table class="comparison-table">
        <thead>
          <tr>
            <th>Specifications</th>
            <th>Commercial Fast Fashion</th>
            <th>Standard Retail</th>
            <th class="highlight-col">ViMi ARCHIVE HOODIE</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Fabric Density (GSM)</strong></td>
            <td>220 – 260 GSM (Thin)</td>
            <td>300 – 320 GSM (Average)</td>
            <td class="highlight-col">450 GSM Heavy French Terry</td>
          </tr>
          <tr>
            <td><strong>Fiber Composition</strong></td>
            <td>65% Poly / 35% Cotton</td>
            <td>80% Cotton / 20% Polyester</td>
            <td class="highlight-col">100% Combed Indian Cotton</td>
          </tr>
          <tr>
            <td><strong>Hood Architecture</strong></td>
            <td>Single-ply (Collapses flat)</td>
            <td>Lined (Weak posture)</td>
            <td class="highlight-col">Double-Layered Stand-Up Hood</td>
          </tr>
          <tr>
            <td><strong>Shoulder Cut</strong></td>
            <td>Standard Narrow Seam</td>
            <td>Slight Relaxed</td>
            <td class="highlight-col">Architectural Drop-Shoulder Boxy</td>
          </tr>
          <tr>
            <td><strong>Post-Wash Shrinkage</strong></td>
            <td>High (5% - 8% shrinkage)</td>
            <td>Moderate (3% - 5%)</td>
            <td class="highlight-col">Zero Shrinkage (Pre-Shrunk & Bio-Washed)</td>
          </tr>
          <tr>
            <td><strong>Pricing (India)</strong></td>
            <td>₹799 – ₹1,299</td>
            <td>₹1,499 – ₹2,499</td>
            <td class="highlight-col">₹1,699 – ₹2,899 (Lifetime Durability)</td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Fabric Matrix",
  "settings": [],
  "presets": [
    {
      "name": "Fabric Matrix"
    }
  ]
}
{% endschema %}
