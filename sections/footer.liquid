<footer class="site-footer">
  <div class="container footer-container">
    
    <div class="footer-top-grid">
      <!-- Col 1: Brand Info -->
      <div class="footer-col footer-col--brand">
        <a href="{{ routes.root_url }}" class="footer-logo">
          <img 
            src="{{ 'vimi-logo.png' | asset_url }}" 
            alt="ViMi Official" 
            class="footer-brand-logo-img"
            onerror="this.src='./assets/vimi-logo.png';"
            width="120"
            height="42"
          >
        </a>
        <p class="footer-about">
          Engineered heavyweight streetwear born in India. Defined by drop-shoulder cuts, high-density French Terry cotton, and enduring monochrome craftsmanship.
        </p>
        <div class="footer-contact">
          <p>📧 support@vimi.in</p>
          <p>📍 Crafted & Dispatched Pan-India</p>
          <p>⏰ Mon - Sat: 10:00 AM – 7:00 PM IST</p>
        </div>
      </div>

      <!-- Col 2: Shop Links -->
      <div class="footer-col">
        <h4 class="footer-col__title">Shop</h4>
        <ul class="footer-links">
          <li><a href="#featured-hoodies">All Hoodies</a></li>
          <li><a href="#featured-hoodies">Oversized (450 GSM)</a></li>
          <li><a href="#featured-hoodies">Vintage Acid Wash</a></li>
          <li><a href="#featured-hoodies">Graphic Drops</a></li>
          <li><a href="#featured-hoodies">Member Exclusives</a></li>
        </ul>
      </div>

      <!-- Col 3: Customer Care -->
      <div class="footer-col">
        <h4 class="footer-col__title">Customer Care</h4>
        <ul class="footer-links">
          <li><a href="#">Track Your Order</a></li>
          <li><a href="#">Shipping Policy (Pan-India)</a></li>
          <li><a href="#">7-Day Exchange & Returns</a></li>
          <li><a href="#">Hoodie Size Guide (Indian Fit)</a></li>
          <li><a href="#">FAQs</a></li>
        </ul>
      </div>

      <!-- Col 4: Newsletter -->
      <div class="footer-col footer-col--newsletter">
        <h4 class="footer-col__title">Join The ViMi Syndicate</h4>
        <p class="newsletter-sub">Get early access to secret hoodie drops and <strong>₹200 off your first order</strong>.</p>
        <form class="footer-newsletter-form" onsubmit="event.preventDefault(); window.handleLoginSuccess('Welcome to ViMi Syndicate! Use promo voucher FIRST200 at checkout.');">
          <input type="email" placeholder="Enter your email or phone" required class="newsletter-input">
          <button type="submit" class="btn btn--primary newsletter-submit">SUBSCRIBE</button>
        </form>
        <div class="newsletter-trust">
          <span>🔒 No spam ever. Unsubscribe anytime.</span>
        </div>
      </div>
    </div>

    <!-- Payment Gateways & Bottom Bar -->
    <div class="footer-bottom">
      <div class="footer-bottom__left">
        <p>&copy; {{ 'now' | date: "%Y" }} <strong>ViMi CLOTHING</strong>. All rights reserved.</p>
      </div>

      <!-- Indian Payment Badges in Monochrome Luxury Style -->
      <div class="footer-payments">
        <span class="pay-chip">UPI</span>
        <span class="pay-chip">GPay</span>
        <span class="pay-chip">PhonePe</span>
        <span class="pay-chip">Paytm</span>
        <span class="pay-chip">RuPay</span>
        <span class="pay-chip">Visa</span>
        <span class="pay-chip">Mastercard</span>
        <span class="pay-chip pay-chip--cod">COD Available</span>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
