    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Defying fast fashion through architectural drop-shoulder cuts, zero-shrink loopback French Terry, and pure monochromatic dominance. Dedicated solely to the ultimate hoodie."
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
