{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HOODIE ARCHIVE 2026"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Engineered boxy drop-shoulder fits. Built with 450 GSM luxury French Terry cotton for supreme comfort. All 27 exclusive hoodie grails."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 32,
      "step": 2,
      "default": 28,
      "label": "Maximum products to show"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
