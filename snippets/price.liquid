{%- comment -%}
  Renders a list of product's price (regular, sale)
  Accepts:
  - product: {Object} Product Liquid object (optional)
  - price: {Number} Custom price (optional)
  - compare_at_price: {Number} Custom compare at price (optional)
{%- endcomment -%}

{%- liquid
  if product
    assign target_price = product.price
    assign target_compare_price = product.compare_at_price
  else
    assign target_price = price | default: 199900
    assign target_compare_price = compare_at_price | default: 299900
  endif

  assign on_sale = false
  if target_compare_price > target_price
    assign on_sale = true
    assign savings = target_compare_price | minus: target_price
    assign discount_percent = savings | times: 100 | divided_by: target_compare_price
  endif
-%}

<div class="price-wrapper {% if on_sale %}price--on-sale{% endif %}">
  <span class="price-item price-item--regular">
    {%- if product -%}
      {{ target_price | money }}
    {%- else -%}
      ₹{{ target_price | divided_by: 100 }}
    {%- endif -%}
  </span>

  {%- if on_sale -%}
    <span class="price-item price-item--compare">
      {%- if product -%}
        {{ target_compare_price | money }}
      {%- else -%}
        ₹{{ target_compare_price | divided_by: 100 }}
      {%- endif -%}
    </span>
    <span class="price-badge-discount">
      {{ discount_percent }}% OFF
    </span>
  {%- endif -%}
</div>
